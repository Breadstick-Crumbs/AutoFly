# AutoFly reads secrets from the environment; never commit real values.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
AUTOFLY_WEBHOOK_URL=https://example.invalid/autofly

# Optional deployment overrides
AUTOFLY_CONFIG=/etc/autofly/config.yaml
AUTOFLY_DATABASE_PATH=/var/lib/autofly/autofly.db
AUTOFLY_LOCK_PATH=/var/lib/autofly/autofly.lock
AUTOFLY_MAX_QUERIES_PER_CYCLE=100
AUTOFLY_FLIGHT_GOAT_COMMAND=flight-goat-pp-cli
