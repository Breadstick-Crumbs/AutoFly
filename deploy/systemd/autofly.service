[Unit]
Description=AutoFly flight-fare check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=autofly
Group=autofly
WorkingDirectory=/opt/autofly
Environment=AUTOFLY_CONFIG=/etc/autofly/config.yaml
Environment=AUTOFLY_DATABASE_PATH=/var/lib/autofly/autofly.db
Environment=AUTOFLY_LOCK_PATH=/var/lib/autofly/autofly.lock
Environment=PATH=/opt/autofly/.venv/bin:/var/lib/autofly/.local/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-/etc/autofly/autofly.env
ExecStart=/opt/autofly/.venv/bin/autofly check --all
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autofly
UMask=0077
